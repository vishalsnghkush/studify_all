{
  "name": "studifysuccess",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "emulator": "cd /d \"%LOCALAPPDATA%\\Android\\Sdk\\emulator\" && emulator -avd Medium_Phone_API_36.1",
    "test": "jest",
    "generate_debug_apk": "cd android && ./gradlew assembleDebug",
    "generate_apk": "cd android && ./gradlew assembleRelease",
    "generate_aab": "npx react-native build-android --mode=release",
    "fastlane:android:internal": "cd android && bundle exec fastlane internal",
    "fastlane:android:beta": "cd android && bundle exec fastlane beta",
    "fastlane:android:production": "cd android && bundle exec fastlane production",
    "postinstall": "patch-package",
    "prepare": "husky"
  },
